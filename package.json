{
  "name": "dongle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server/main.ts",
    "admin": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env.local server/cli.ts",
    "deploy": "bash deploy/deploy.sh",
    "typecheck": "tsc --noEmit",
    "check:manuals": "node scripts/check-manuals.mjs",
    "audit:selftest": "node scripts/audit-selftest.mjs",
    "api:selftest": "node scripts/api-selftest.mjs",
    "import:selftest": "node scripts/import-selftest.mjs",
    "trend:selftest": "node scripts/trend-selftest.mjs",
    "shoot": "node scripts/shoot-manuals.mjs",
    "covers": "node scripts/covers.mjs",
    "plaza": "node scripts/plaza.mjs",
    "icons": "node scripts/icons.mjs",
    "tripo:check": "node scripts/tripo-check.mjs",
    "tripo": "node scripts/tripo.mjs",
    "model:info": "node scripts/model-info.mjs",
    "model:views": "node scripts/model-views.mjs",
    "model:section": "node scripts/model-section.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
