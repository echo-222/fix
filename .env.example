# 复制为 .env.local 并填写（.env.local 已在 .gitignore 里，不会提交）。
# 这里的变量只在服务端（开发服务器 / npm start / 脚本）里读取；不要加 VITE_ 前缀，否则会被打包进浏览器代码。
# 线上服务器读的是 /etc/dongle.env（格式一样，见 deploy/）。

# ---------- 账号 ----------
# 这些邮箱注册时不用邀请码，并且自动成为管理员（逗号分隔）
ADMIN_EMAILS=
# 数据目录：SQLite 数据库 dongle.db 和用户上传的图片都在这里
# DATA_DIR=data

# 注册要不要邮箱验证码。默认不要（邮箱 + 邀请码 + 密码直接注册，忘了密码由管理员在后台重置）；
# 设成 1：注册要验证码，登录页多一个「忘记密码」可以用验证码自己重设（要配下面的 SMTP）
# EMAIL_VERIFY=1

# ---------- 发验证码的邮箱（SMTP，EMAIL_VERIFY=1 时才用） ----------
# 不填：验证码打印在服务端日志里，管理后台概览页也能看到，可以手动转告。
# 阿里云服务器封了 25 端口，用 465（SSL）。QQ 邮箱：smtp.qq.com + 授权码；阿里云邮件推送：smtpdm.aliyun.com。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人，不填就是「懂了 Dongle <SMTP_USER>」
# MAIL_FROM=懂了 Dongle <no-reply@tripolabs.com>

# ---------- 线上服务（npm start） ----------
# PORT=3000
# HOST=127.0.0.1

# ---------- 说明书 AI 解析 ----------
# 任何兼容 OpenAI Chat Completions 且支持图片输入的模型都可以。
# 未配置时，导入说明书会进入「演示模式」，使用示例解析结果。

# OpenAI
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o

# 「说明书 → 3D 交互说明书」流水线用的模型（网页导入 PDF / 照片，内置 manual-to-3d skill）。
# 要能看图、单次输出 3–6 万字的 JSON：建议用最强的一档（如 gpt-5.5）；不填就用 AI_MODEL。
AI_MANUAL_MODEL=
# 推理强度（low / medium / high，模型不支持时自动去掉）、单次最大输出 tokens（输出被截断时调大）
AI_REASONING_EFFORT=
AI_MAX_TOKENS=

# 通义千问（DashScope 兼容模式）示例：
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-vl-max
# AI_MANUAL_MODEL=qwen-vl-max

# ---------- Tripo 3D 模型生成 ----------
# Key 在 Tripo 开发者平台「API 密钥」页创建（tsk_ 开头，只显示一次）。
# Key 在哪个站创建，就填哪个站的地址：
#   国内站 https://openapi.tripo3d.com/v3（developers.tripo3d.com）
#   国际站 https://openapi.tripo3d.ai/v3（developers.tripo3d.ai）
# 只用 v3 接口：旧的 api.tripo3d.ai/v2/openapi 于 2026-10-31 停用。
TRIPO_API_KEY=
TRIPO_BASE_URL=https://openapi.tripo3d.com/v3
# 生成模型版本：v3.1-20260211 = H3.1（支持 generate_parts 分块生成）；P1-20260311 不支持分块
TRIPO_MODEL=v3.1-20260211
# 网页导入一份说明书最多生成几个外观模型（每个约 20–40 积分）
# TRIPO_MAX_PARTS=4

# ---------- 网页导入的说明书 ----------
# 生成的说明书（场景脚本、页面图、外观模型）和中间文件放哪；线上是 /var/lib/dongle/imported 和 import-work（deploy/dongle.service）
# IMPORT_DIR=public/imported
# IMPORT_WORK_DIR=manuals-src/imports
# 每人同时最多 1 个、全站同时最多 MANUAL_MAX_JOBS 个生成任务；普通用户每天最多 MANUAL_DAILY_LIMIT 份（管理员不限）
# MANUAL_MAX_JOBS=2
# MANUAL_DAILY_LIMIT=10
# 截图复核用的 Chrome（不填就找本机装的 Google Chrome）；线上是 /opt 下的 chrome-headless-shell（deploy/setup-server.sh 装）
# CHROME_PATH=

# ---------- 热榜（后台「热度」：联网监控市场热度，自动生成热门产品发到广场）----------
# 默认用上面的 AI 服务联网搜索（Responses API web_search / Chat web_search_options / 通义 enable_search，自动试）。
# 当前模型不支持联网时，单独给搜索指定模型；需要时连服务地址和 Key 一起换
# AI_SEARCH_MODEL=
# AI_SEARCH_BASE_URL=
# AI_SEARCH_API_KEY=
# 信号来源（电商·新闻 / 小红书 / B 站）和品牌榜个数在后台「热度 → 设置」里改。B 站直接调公开接口（不用登录、不用 Key）；
# 小红书没有开放接口，靠联网搜索看种草 / 合作笔记和第三方榜单
# 只给自测用：允许访问的内网主机（npm run trend:selftest 设 127.0.0.1）。线上不要设
# TREND_ALLOW_HOSTS=
# 只给自测用：B 站接口换成假的（npm run trend:selftest 指到 mock）、联网搜索多久没数据算卡住（默认 180000 毫秒）。线上不要设
# TREND_BILI_BASE=
# SEARCH_IDLE_MS=
# 服务器在国内连不上 api.openai.com：换国内能直连的服务（上面的 DashScope），或者走代理
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://127.0.0.1:7890
